# ==============================================================================
# KrishiNetra Production Environment Variables Template (.env.example)
# Copy this file to .env and customize for your environment.
# DO NOT commit real secrets or API keys to version control.
# ==============================================================================

# --- Server Configuration ---
ENV=production
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# --- Database Configuration ---
# For SQLite (default):
DATABASE_URL=sqlite:///./farmai.db
# For Production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/krishinetra

# --- Machine Learning Engine Configuration ---
DEMO_MODE=false
MODEL_WEIGHTS_PATH=models/weights/efficientnet_b3.pth
CLASS_NAMES_PATH=models/weights/class_names.json
DISEASES_KB_PATH=knowledge_base/diseases.json

# --- External Telemetry & APIs ---
OPEN_METEO_TIMEOUT=5.0
SENTINEL_TIMEOUT=8.0

# --- Authentication & JWT Security ---
JWT_SECRET_KEY=replace_with_a_secure_random_64_char_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM / Agricultural Advisory (Optional) ---
ANTHROPIC_API_KEY=
